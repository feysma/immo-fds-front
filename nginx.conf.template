server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Compression
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Cache long terme pour les assets hachés (Angular output hashing)
    location ~* \.(js|css|woff2?|ttf|eot|ico|png|jpg|jpeg|svg|webp)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # env.js : jamais mis en cache (regénéré à chaque démarrage du conteneur)
    location = /env.js {
        expires off;
        add_header Cache-Control "no-store";
    }

    # Proxy vers l'API Spring Boot (URL injectée via la variable API_URL)
    # location /api/ avec proxy_pass sans slash → nginx conserve le préfixe /api/ dans le path upstream
    location /api/ {
        proxy_pass NGINX_API_URL;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback : toutes les routes inconnues → index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
